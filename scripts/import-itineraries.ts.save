npx tsx scripts/import-itineraries.ts

import ExcelJS from "exceljs";
import { Pool } from "pg";
import path from "node:path";

type SheetRow = Record<string, unknown>;

function text(value: unknown): string {
  if (value === null || value === undefined) {
    return "";
  }

  if (
    typeof value === "string" ||
    typeof value === "number" ||
    typeof value === "boolean"
  ) {
    return String(value).trim();
  }

  if (typeof value === "object") {
    const cell = value as Record<string, unknown>;

    // Formula cells: use their cached result, not the formula object.
    if ("result" in cell) {
      return text(cell.result);
    }

    // Rich-text cells.
    if (Array.isArray(cell.richText)) {
      return cell.richText
        .map((part) => {
          if (
            typeof part === "object" &&
            part !== null &&
            "text" in part
          ) {
            return text(part.text);
          }

          return "";
        })
        .join("")
        .trim();
    }

    // Hyperlink or other text-bearing cells.
    if ("text" in cell) {
      return text(cell.text);
    }

    return "";
  }

  return "";
}

function number(value: unknown, fallback = 0): number {
  if (value === null || value === undefined || value === "") {
    return fallback;
  }

  const result = Number(value);

  if (!Number.isFinite(result)) {
    throw new Error(`Invalid number: ${String(value)}`);
  }

  return result;
}

function boolean(value: unknown): boolean {
  if (typeof value === "boolean") return value;

  return ["true", "1", "yes"].includes(text(value).toLowerCase());
}

function rowsFromSheet(sheet: ExcelJS.Worksheet): SheetRow[] {
  const headers: string[] = [];

  sheet.getRow(1).eachCell((cell, column) => {
    headers[column] = text(cell.value);
  });

  const result: SheetRow[] = [];

  for (let rowNumber = 2; rowNumber <= sheet.rowCount; rowNumber++) {
    const row = sheet.getRow(rowNumber);
    const record: SheetRow = {};

    headers.forEach((header, column) => {
      if (header) {
        record[header] = row.getCell(column).value;
      }
    });

    if (
      Object.values(record).some(
        (value) => value !== null && value !== undefined && value !== ""
      )
    ) {
      result.push(record);
    }
  }

  return result;
}

async function main() {
  const connectionString = process.env.DATABASE_URL;

  if (!connectionString) {
    throw new Error("DATABASE_URL is missing from .env.local");
  }

  const filePath = path.resolve(
    process.cwd(),
    "data/the_local_route_full_itineraries.xlsx"
  );

  const workbook = new ExcelJS.Workbook();
  await workbook.xlsx.readFile(filePath);

  const itinerarySheet = workbook.getWorksheet("Itineraries");
  const daysSheet = workbook.getWorksheet("Days");
  const locationsSheet = workbook.getWorksheet("Locations");
  const dayLocationsSheet = workbook.getWorksheet("Day_Locations");
  const tagsSheet = workbook.getWorksheet("Tags");
  const itineraryTagsSheet = workbook.getWorksheet("Itinerary_Tags");

  if (
    !itinerarySheet ||
    !daysSheet ||
    !locationsSheet ||
    !dayLocationsSheet ||
    !tagsSheet ||
    !itineraryTagsSheet
  ) {
    throw new Error(
      "Required sheets: Itineraries, Days, Locations, Day_Locations, Tags, Itinerary_Tags."
    );
  }

  const itineraryRows = rowsFromSheet(itinerarySheet);
  const dayRows = rowsFromSheet(daysSheet);
  const locationRows = rowsFromSheet(locationsSheet);
  const dayLocationRows = rowsFromSheet(dayLocationsSheet);
  const tagRows = rowsFromSheet(tagsSheet);
  const itineraryTagRows = rowsFromSheet(itineraryTagsSheet);

  if (itineraryRows.length === 0) {
    throw new Error("The Itineraries sheet contains no data rows.");
  }

  for (const column of [
    "itinerary_id",
    "slug",
    "title",
    "destination",
    "duration_days",
  ]) {
    if (!(column in itineraryRows[0])) {
      throw new Error(`Missing Itineraries column: ${column}`);
    }
  }

  // Map each tag ID to its category and value.
  const tagsById = new Map<
    string,
    { category: string; value: string }
  >();

  for (const row of tagRows) {
    const tagId = text(row.tag_id);
    const category = text(row.category).toLowerCase();
    const value = text(row.value).toLowerCase();

    if (tagId && category && value) {
      tagsById.set(tagId, { category, value });
    }
  }

  // Group tags by the workbook's itinerary_id.
  const metadataByItinerary = new Map<
    string,
    Record<string, string[]>
  >();

  for (const row of itineraryTagRows) {
    const itineraryId = text(row.itinerary_id);
    const tagId = text(row.tag_id);
    const tag = tagsById.get(tagId);

    if (!itineraryId || !tag) continue;

    const metadata = metadataByItinerary.get(itineraryId) ?? {};
    const values = metadata[tag.category] ?? [];

    if (!values.includes(tag.value)) {
      values.push(tag.value);
    }

    metadata[tag.category] = values;
    metadataByItinerary.set(itineraryId, metadata);
  }
  // DEBUG: Inspect the tag mapping before importing.
  console.log("\n--- TAG IMPORT DIAGNOSTICS ---");

  console.log("Tag definitions found:", tagsById.size);
  console.log("Itinerary-tag relationships found:", itineraryTagRows.length);
  console.log("Itineraries with tag metadata:", metadataByItinerary.size);

  console.log("\nSample tag definitions:");
  console.log(Array.from(tagsById.entries()).slice(0, 10));

  console.log("\nSample itinerary-tag relationships:");
  console.log(
    itineraryTagRows.slice(0, 10).map((row) => ({
      itinerary_id: text(row.itinerary_id),
      tag_id: text(row.tag_id),
      matched_tag: tagsById.get(text(row.tag_id)) ?? null,
    }))
  );

  console.log("\nMetadata for Kashmir and Kargil:");
  console.log({
    kashmir: metadataByItinerary.get("kashmir-autumn") ?? null,
    kargil:
      metadataByItinerary.get("kargil-autumn-7-days") ?? null,
  });

  console.log("--- END DIAGNOSTICS ---\n");
  // Build a location ID -> location name map.
  const locationNames = new Map<string, string>();

  for (const location of locationRows) {
    const id = text(location.location_id);
    const name = text(location.name);

    if (id && name) {
      locationNames.set(id, name);
    }
  }

  // Group location names by itinerary and day.
  const locationsByDay = new Map<
    string,
    { sortOrder: number; name: string }[]
  >();

  for (const row of dayLocationRows) {
    const itineraryId = text(row.itinerary_id);
    const dayNumber = number(row.day_number, -1);

    if (!itineraryId || dayNumber < 1) continue;

    const key = `${itineraryId}::${dayNumber}`;
    const locationId = text(row.location_id);
    const name =
      text(row.location_name) || locationNames.get(locationId) || "";

    if (!name) continue;

    const list = locationsByDay.get(key) ?? [];

    list.push({
      sortOrder: number(row.sort_order, list.length + 1),
      name,
    });

    locationsByDay.set(key, list);
  }

  // Build each itinerary's day JSON from Days and Day_Locations.
  const daysByItinerary = new Map<string, object[]>();

  for (const row of dayRows) {
    const itineraryId = text(row.itinerary_id);
    const dayNumber = number(row.day_number, -1);

    if (!itineraryId || dayNumber < 1) continue;

    const key = `${itineraryId}::${dayNumber}`;

    const locations = (locationsByDay.get(key) ?? [])
      .sort((a, b) => a.sortOrder - b.sortOrder)
      .map((item) => item.name);

    const list = daysByItinerary.get(itineraryId) ?? [];

    list.push({
      day: dayNumber,
      day_key: text(row.day_key),
      title: text(row.title),
      description: text(row.description),
      locations,
    });

    daysByItinerary.set(itineraryId, list);
  }

  // Sort days in ascending order.
  for (const days of daysByItinerary.values()) {
    days.sort(
      (a, b) =>
        Number((a as { day: number }).day) -
        Number((b as { day: number }).day)
    );
  }

  const seenSlugs = new Set<string>();
  const pool = new Pool({ connectionString });

  try {
    const client = await pool.connect();

    try {
      await client.query("BEGIN");

      let imported = 0;

      for (const row of itineraryRows) {
        const sourceId = text(row.itinerary_id);
        const slug = text(row.slug);
        const title = text(row.title);
        const destination = text(row.destination);
        const durationDays = number(row.duration_days);
        const price = number(row.price);
        const premium = boolean(row.is_premium);

        if (!sourceId || !slug || !title || !destination) {
          throw new Error(
            `Missing required itinerary fields: ${JSON.stringify(row)}`
          );
        }

        if (seenSlugs.has(slug)) {
          throw new Error(`Duplicate slug in Excel: ${slug}`);
        }

        seenSlugs.add(slug);

        if (!Number.isInteger(durationDays) || durationDays <= 0) {
          throw new Error(`Invalid duration for ${slug}`);
        }

        if (price < 0) {
          throw new Error(`Negative price for ${slug}`);
        }

        const days = daysByItinerary.get(sourceId) ?? [];
        const metadata = metadataByItinerary.get(sourceId) ?? {};

        await client.query(
          `INSERT INTO itineraries (
             slug,
             title,
             destination,
             duration_days,
             description,
             cover_image,
             is_premium,
             price,
             days_json,
             metadata,
             updated_at
           )
           VALUES (
             $1, $2, $3, $4, $5, $6, $7, $8,
             $9::jsonb, $10::jsonb, NOW()
           )
           ON CONFLICT (slug) DO UPDATE SET
             title = EXCLUDED.title,
             destination = EXCLUDED.destination,
             duration_days = EXCLUDED.duration_days,
             description = EXCLUDED.description,
             cover_image = EXCLUDED.cover_image,
             is_premium = EXCLUDED.is_premium,
             price = EXCLUDED.price,
             days_json = EXCLUDED.days_json,
             metadata = EXCLUDED.metadata,
             updated_at = NOW()`,
          [
            slug,
            title,
            destination,
            durationDays,
            text(row.description) || null,
            text(row.cover_image) || null,
            premium,
            price,
            JSON.stringify(days),
            JSON.stringify(metadata),
          ]
        );

        imported++;
      }

      await client.query("COMMIT");

      console.log("Excel import completed successfully.");
      console.log(`Itineraries processed: ${imported}`);
      console.log(`Day records read: ${dayRows.length}`);
      console.log(`Location records read: ${locationRows.length}`);
      console.log(`Day-location records read: ${dayLocationRows.length}`);
      console.log(`Tag definitions read: ${tagRows.length}`);
      console.log(`Itinerary-tag relationships read: ${itineraryTagRows.length}`);
      console.log(`Itineraries with tags: ${metadataByItinerary.size}`);
      console.log("Existing records absent from Excel were not deleted.");
    } catch (error) {
      await client.query("ROLLBACK");
      throw error;
    } finally {
      client.release();
    }
  } finally {
    await pool.end();
  }
}

main().catch((error: unknown) => {
  console.error("Excel import failed:", error);
  process.exitCode = 1;
});
